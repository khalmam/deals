# Copy to .env and fill in. Sandbox credentials only.
SECRET_KEY=change-me
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deals
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional. Without a key the negotiation runs on the rules engine alone.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model provider: anthropic (needs ANTHROPIC_API_KEY) or bedrock (AWS credentials)
LLM_PROVIDER=anthropic
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# The sandbox account that receives the demo sub-contractor payout (a personal account).
DEMO_SUB_EMAIL=...
